# Copy this file to .env and fill in your keys
#
# NOTE ON FRONTEND ENVIRONMENT VARIABLES:
# Variables prefixed with VITE_ are embedded into the client-side JavaScript bundle
# at build time and are publicly readable by anyone inspecting the web application.
# Do not store sensitive backend private keys or secrets in VITE_ variables.

# Google Gemini API Key — get yours at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (leave as default for local development)
VITE_API_URL=http://localhost:8080/api

# Firebase Client Configuration (Public Web Client Identifiers)
# Access control must be enforced via Firebase Security Rules and Google Cloud HTTP Referrer restrictions.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
