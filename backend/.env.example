# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=elevate_db

# Security & Session Tokens
# Generate a strong 256-bit secret for production: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
PORT=8080

# Google Gemini API Keys (comma-separated list for multi-key rotation)
GEMINI_API_KEY=your_gemini_api_key_here
